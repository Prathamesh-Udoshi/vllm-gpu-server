# ==============================================================================
# Enterprise vLLM Production Platform - Environment Configuration Example
# Copy this file to '.env' and update the values for your deployment environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Model & Engine Configuration
# ------------------------------------------------------------------------------
# Hugging Face model identifier or path to local model directory
MODEL_NAME=Qwen/Qwen2.5-0.5B-Instruct

# Quantization method ('awq', 'gptq', 'fp8', or leave empty for unquantized)
QUANTIZATION=

# Data type for model weights ('auto', 'float16', 'bfloat16', 'float32')
DTYPE=auto

# Number of GPUs to partition model across (Tensor Parallelism)
TENSOR_PARALLEL_SIZE=1

# Fraction of GPU memory allocated for vLLM model weights & KV cache (0.0 to 1.0)
GPU_MEMORY_UTILIZATION=0.90

# Maximum context window length in tokens
MAX_MODEL_LEN=4096

# Maximum number of concurrent sequences processed in a single iteration
MAX_NUM_SEQS=256

# Maximum total tokens across all sequences in a single batch
MAX_NUM_BATCHED_TOKENS=4096

# CPU swap memory reserved for KV cache block offloading (in GB)
SWAP_SPACE=4

# Enable automatic KV cache prefix sharing across identical prompt prefixes (true/false)
ENABLE_PREFIX_CACHING=true

# Allow downloading and executing custom code from Hugging Face repositories (true/false)
TRUST_REMOTE_CODE=true

# Model revision (branch, tag, or commit hash; leave empty for main/latest)
REVISION=

# Data type for KV cache blocks ('auto', 'fp8')
KV_CACHE_DTYPE=auto

# Force eager execution mode and disable CUDA Graph capture (true/false)
ENFORCE_EAGER=false

# Directory path for caching downloaded Hugging Face weights
DOWNLOAD_DIR=/workspace/.cache/huggingface

# Execution target device ('cuda' for GPU, 'cpu' for CPU-only mode)
DEVICE=cuda

# Optional Hugging Face API token for downloading gated/private models (e.g., Llama 3)
# HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ------------------------------------------------------------------------------
# 2. Security & Access Control
# ------------------------------------------------------------------------------
# Optional secret key for authenticating REST API requests via Bearer token
# Leave empty or commented out to allow open access without API key verification
API_KEY=

# Allowed CORS origins (comma-separated list of URLs, or '*' for all origins)
CORS_ORIGINS=*

# ------------------------------------------------------------------------------
# 3. API Server & Observability
# ------------------------------------------------------------------------------
# Network host address to bind the API server
HOST=0.0.0.0

# Network port for API HTTP traffic
PORT=8000

# Server logging verbosity level ('debug', 'info', 'warning', 'error', 'critical')
LOG_LEVEL=info

# Enable Prometheus metrics scraping endpoint at /metrics (true/false)
ENABLE_METRICS=true
